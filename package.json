{
	"name": "ielts-monorepo",
	"private": true,
	"workspaces": [
		"server",
		"shared",
		"client"
	],
	"scripts": {
		"check": "npm run check --workspaces --if-present",
		"dep:init": "depcruise --init",
		"dep": "npm run dep --workspaces --if-present",
		"dep:d2": "npm run dep:d2 --workspaces --if-present",
		"dep:html": "npm run dep:html --workspaces --if-present",
		"dep:lint": "npm run dep:lint --workspaces --if-present",
		"lint": "npm run lint --workspaces --if-present",
		"lint:fix": "npm run lint:fix --workspaces --if-present",
		"lint:format": "npm run lint:format --workspaces --if-present",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "npm run test:unit --workspaces --if-present -- --run",
		"test:e2e": "npm run test:e2e --workspace=client --if-present"
	},
	"devDependencies": {
		"dependency-cruiser": "*"
	}
}
