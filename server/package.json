{
	"name": "ielts-server",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"check": "tsc --noEmit",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"dev": "wrangler dev",
		"deploy": "wrangler deploy --minify",
		"dep": "depcruise -c ../.dependency-cruiser.js src",
		"dep:d2": "depcruise -c ../.dependency-cruiser.js src -T d2 | d2 play -",
		"dep:html": "depcruise -c ../.dependency-cruiser.js src -T err-html -f ../depcruise-server.html",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "eslint . --fix",
		"lint:format": "prettier --write .",
		"test": "npm run test:unit -- --run",
		"test:unit": "vitest"
	},
	"dependencies": {
		"@hono/standard-validator": "^0.2.3",
		"@inferdi/hono": "^6.0.2",
		"@inferdi/inferdi": "^6.0.2",
		"@scalar/hono-api-reference": "^0.12.0",
		"harper.js": "^2.7.0",
		"hono": "^4.13.5",
		"hono-openapi": "^1.3.1",
		"ielts-shared": "*",
		"marked": "^18.0.11",
		"sanitize-html": "^2.17.7",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.1.2",
		"@eslint/js": "^10.0.1",
		"@hono/eslint-config": "^2.1.1",
		"@types/node": "^26.4.0",
		"@types/sanitize-html": "^2.16.1",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.9.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.1.11",
		"wrangler": "^4.127.1"
	}
}
