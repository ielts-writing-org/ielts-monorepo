{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "ielts-server",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-24",
	"compatibility_flags": ["nodejs_compat"],
	"env": {
		"development": {
			"observability": {
				"enabled": true,
				"head_sampling_rate": 1
			}
		},
		"production": {
			"observability": {
				"enabled": true,
				"head_sampling_rate": 0.01
			}
		}
	},
	"kv_namespaces": [
		{
			"binding": "TASK1_KV",
			"id": "0fa03557573b4abc97f48a56d47fd7ee"
		},
		{
			"binding": "TASK2_KV",
			"id": "cc61a444e44740b6b1d9ff59a1f3f75b"
		}
	],
	"r2_buckets": [
		{
			"binding": "TASK1_BUCKET",
			"bucket_name": "my-bucket"
		}
	],
	"d1_databases": [
		{
			"binding": "MAIN_DB",
			"database_name": "main-database",
			"database_id": "08b1ad6e-a246-4320-a434-ff2f3f6d7e05"
		}
	],
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"images": {
		"binding": "IMAGES"
	},
	"cache": {
		"enabled": true
	}
}
