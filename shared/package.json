{
	"name": "ielts-shared",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"exports": {
		".": "./src/index.ts",
		"./configs": "./src/configs/index.ts",
		"./schemas": "./src/schemas/index.ts",
		"./utils": "./src/utils/index.ts"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"dep": "depcruise -c ../.dependency-cruiser.js src --ts-config tsconfig.json -T err-html -f ../depcruise-shared-error.html",
		"dep:d2": "depcruise -c ../.dependency-cruiser.js src --ts-config tsconfig.json -T d2 | d2 play -",
		"dep:html": "depcruise -c ../.dependency-cruiser.js src --ts-config tsconfig.json -T err-html -f ../depcruise-shared.html",
		"dep:lint": "depcruise -c ../.dependency-cruiser.js src --ts-config tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "eslint . --fix",
		"lint:format": "prettier --write .",
		"test": "npm run test:unit -- --run",
		"test:unit": "vitest"
	},
	"dependencies": {
		"harper.js": "^2.7.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.9.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.1.11"
	}
}
