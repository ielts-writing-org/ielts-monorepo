{
	"name": "ielts-shared",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"exports": {
		".": "./src/index.ts",
		"./configs/*": "./src/configs/*.ts",
		"./schemas/*": "./src/schemas/*.ts",
		"./utils/*": "./src/utils/*.ts"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "eslint . --fix",
		"lint:format": "prettier --write .",
		"test": "npm run test:unit -- --run",
		"test:unit": "vitest"
	},
	"dependencies": {
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.5.1",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"typescript-eslint": "^8.70.0",
		"vitest": "^4.1.11"
	}
}
