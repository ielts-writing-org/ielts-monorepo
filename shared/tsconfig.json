{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"lib": ["ESNext"],

		"verbatimModuleSyntax": true,
		"rewriteRelativeImportExtensions": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true
	}
}
