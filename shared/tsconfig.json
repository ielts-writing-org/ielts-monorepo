{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"lib": ["ESNext"],
		"rootDir": "./src",
		"outDir": "./dist",
		"verbatimModuleSyntax": true,
		"rewriteRelativeImportExtensions": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"noEmit": true
	},
	"include": ["./src/**/*.ts", "./src/**/*.d.ts"]
}
